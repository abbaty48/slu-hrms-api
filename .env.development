NODE_ENV=development
PORT=3000
HOST=0.0.0.0
SERVER_VERSION=1.0.0

CORS_ORIGINS=http://localhost:5173,http://localhost:3500,http://localhost:3001
CORS_METHODS=GET,PUT,POST,DELETE,PATCH,OPTIONS
CORS_ALLOW_HEADERS=Content-Type,Authorization
CORS_ALLOW_CREDENTIALS=false
CORS_PREFLIGHT_MAX_AGE=86400

COOKIE_SECRET=13b06b5bf801e6beb4bc3a2fe1f22c963c3c978c1941d3af4e91b7083465eaef
JWT_SECRET=dev_jwt_secret_key_12345678901234567890123456
JWT_ALGORITHM=HS256
JWT_SIGN_OPTIONS_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES=7d
USE_REDIS_FOR_JWT=false

CACHE_DRIVER=memory
REDIS_URL=redis://127.0.0.1:6379
DEFAULT_CACHE_TTL=3600
LRU_MAX=5000

RATE_LIMIT_MAX=1000
RATE_LIMIT_TIME_WINDOW=900000
RATE_LIMIT_CACHE=memory
RATE_LIMIT_SKIP_ON_ERROR=true

COMPRESS_THRESHOLD=1024
COMPRESS_LEVEL=6
COMPRESS_TYPES=application/json,text/html,text/plain,text/css,application/javascript,application/xml

BODY_LIMIT=1024
FORM_BODY_LIMIT=5120

STATIC_ROOT=./public
STATIC_PREFIX=/public
STATIC_MAX_AGE=86400000
STATIC_CACHE_CONTROL=public, max-age=86400
STATIC_CONSTRAINTS=true

SWAGGER_TITLE=SLU HRMS API (Development)
SWAGGER_DESCRIPTION=Sule Lamido University Human Resource Management System API
SWAGGER_VERSION=1.0.0
SWAGGER_PREFIX=/api/docs
SWAGGER_HOST=localhost:3000
SWAGGER_HIDE_UNTAGGED=false

DATABASE_URL=postgres://postgres:@localhost:5432/sluk-hrms-db
