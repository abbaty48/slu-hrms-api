NODE_ENV=production
PORT=3000

CORS_ORIGINS=https://slu.edu.ng,https://www.slu.edu.ng,https://app.slu.edu.ng
CORS_ALLOW_CREDENTIALS=true

COOKIE_SECRET=change_me_with_strong_random_32_char_string
HELMET_ALLOWED_ORIGINS=slu.edu.ng,www.slu.edu.ng,app.slu.edu.ng

JWT_SECRET=change_me_with_strong_random_32_char_string
JWT_ALGORITHM=RS256
JWT_SIGN_OPTIONS_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES=30d
USE_REDIS_FOR_JWT=true

CACHE_DRIVER=redis
REDIS_URL=redis://user:password@redis.slu.edu.ng:6379
DEFAULT_CACHE_TTL=86400

RATE_LIMIT_MAX=100
RATE_LIMIT_CACHE=redis
RATE_LIMIT_SKIP_ON_ERROR=false

COMPRESS_LEVEL=9

STATIC_MAX_AGE=2592000000
STATIC_CACHE_CONTROL=public, max-age=2592000, immutable

SWAGGER_TITLE=SLU HRMS API (Production)
SWAGGER_HIDE_UNTAGGED=true

DATABASE_URL=postgresql://hrms_user:password@db.production.slu.edu.ng:5432/slu_hrms_production
